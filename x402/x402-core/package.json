{
  "name": "@autonomy/x402-core",
  "version": "0.1.0",
  "description": "Core types, CAIP-2 chains, and crypto utilities for X402 multi-chain payment protocol",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "x402",
    "http-402",
    "payment",
    "blockchain",
    "solana",
    "ethereum",
    "bitcoin",
    "caip",
    "multi-chain",
    "bot-verification",
    "cloudflare"
  ],
  "author": "OpenClawd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/autonomy-economy.git",
    "directory": "packages/x402-core"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.9",
    "eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
