{
  "name": "@autonomy/x402-facilitator",
  "version": "0.1.0",
  "description": "Multi-chain payment facilitator for X402 protocol on Cloudflare Workers",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "tail": "wrangler tail",
    "kv:create": "wrangler kv:namespace create RECEIPTS",
    "kv:create:preview": "wrangler kv:namespace create RECEIPTS --preview"
  },
  "keywords": [
    "x402",
    "payment",
    "facilitator",
    "cloudflare-workers",
    "solana",
    "ethereum",
    "bitcoin",
    "bot-verification"
  ],
  "author": "OpenClawd",
  "license": "MIT",
  "dependencies": {
    "@autonomy/x402-core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20231218.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "wrangler": "^3.22.0",
    "vitest": "^4.1.8",
    "eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
