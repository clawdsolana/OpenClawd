{
  "name": "@openclawdsolana/obsidian-openclawd",
  "version": "0.1.0",
  "private": true,
  "description": "Official OpenClawd Obsidian plugin for Solana trading notes, Membrain ingestion queues, and Honcho session exports.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "obsidian",
    "openclawd",
    "solana",
    "membrain",
    "honcho",
    "ai-agents"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.17.19",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.28.1",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.3"
  }
}
