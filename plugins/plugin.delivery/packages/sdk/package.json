{
  "name": "@openclawdsolana/plugin-sdk",
  "version": "1.1.2",
  "description": "OpenClawd Plugin SDK — build plugins with on-chain attestation, OpenAPI parsing, and Zod schemas. Includes Solana Attestation Service helpers.",
  "keywords": [
    "openclawd",
    "openclawd",
    "sdk",
    "plugin",
    "chat-plugin"
  ],
  "homepage": "https://solanaclawd.com",
  "repository": {
    "type": "git",
    "url": "https://solanaclawd.com"
  },
  "license": "MIT",
  "author": "OpenClawd <contact@openclawd.net>",
  "sideEffects": false,
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "import": "./index.ts",
      "require": "./index.ts",
      "types": "./index.ts"
    },
    "./client": {
      "import": "./client/index.ts",
      "types": "./client/index.ts"
    },
    "./schema": {
      "import": "./schema/index.ts",
      "types": "./schema/index.ts"
    },
    "./openapi": {
      "import": "./openapi/index.ts",
      "types": "./openapi/index.ts"
    }
  },
  "files": [
    "index.ts",
    "error.ts",
    "request.ts",
    "openapi.ts",
    "client",
    "client.ts",
    "schema",
    "openapi",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@types/json-schema": "^7.0.14",
    "openapi-jsonschema-parameters": "^12.1.3",
    "openapi-types": "^12.1.3",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^19.2.3",
    "@vitest/web-worker": "^4.1.5",
    "jsdom": "^29.1.0",
    "ramda": "^0.30.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "swagger-client": "^3.37.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8"
  }
}
