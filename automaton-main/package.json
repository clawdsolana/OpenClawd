{
  "name": "@openclawdsolana/automaton",
  "version": "0.1.0",
  "description": "OpenClawd Automaton — sovereign self-replicating AI agent runtime. Born inside the OpenClawd lobster framework, runs the Sense → Think → Strike → Drift loop with on-chain identity (SAS), self-versioned shell.md, scheduled heartbeats, and skill replication.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config.js": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./state/database.js": {
      "types": "./dist/state/database.d.ts",
      "default": "./dist/state/database.js"
    }
  },
  "bin": {
    "automaton": "dist/index.js",
    "openclawd-automaton": "dist/index.js"
  },
  "files": [
    "dist",
    "constitution.md",
    "scripts/conways-rules.txt",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://solanaclawd.com",
    "directory": "automaton-main"
  },
  "homepage": "https://solanaclawd.com",
  "bugs": {
    "url": "https://solanaclawd.com"
  },
  "keywords": [
    "openclawd",
    "openclawdsolana",
    "automaton",
    "autonomous-agent",
    "sovereign-ai",
    "self-replicating",
    "solana",
    "leviathan",
    "lobster",
    "sas",
    "siwe",
    "siws"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc && pnpm -r build || npm -ws --if-present run build",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "clean": "rm -rf dist && (pnpm -r clean || npm -ws --if-present run clean)"
  },
  "dependencies": {
    "@honcho-ai/sdk": "^2.1.1",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "cron-parser": "^4.9.0",
    "gray-matter": "^4.0.3",
    "ora": "^8.0.0",
    "simple-git": "^3.24.0",
    "siwe": "^2.3.0",
    "ulid": "^2.3.0",
    "viem": "^2.44.2",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
